{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webmcp-proof",
  "main": "site/build/worker.bundled.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "bun run site:build" },
  "vars": {
    "DEMO_AUTH": "webmcp:replace-with-a-long-random-password"
  },
  "durable_objects": {
    "bindings": [{ "name": "SCOPE", "class_name": "ScopeState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScopeState"] }]
}
