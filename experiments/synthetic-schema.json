{
  "$id": "webmcp-lab.synthetic-result.v0",
  "required": ["schema", "id", "synthetic", "observed", "gate"],
  "gate": {
    "required": ["normalUrl", "toolDiscovery", "agentCall", "sharedMutation", "cloudflareLoadBearing", "authorityVisible"],
