{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "webmcp-proof",
  "account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
  "main": "build/worker.bundled.mjs",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "bun run site:build" },
  "durable_objects": {
    "bindings": [{ "name": "SCOPE", "class_name": "ScopeState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScopeState"] }],
  "routes": [{ "pattern": "webmcp-proof.coey.dev", "custom_domain": true }]
}
